use Sparky::JobApi;

my $check = tags()<check>;
my $in = tags()<in>;

my $cwd = "{$*CWD}";
bash "curl -s $check -L -o task.check",%(
   :$cwd,
);
bash "curl -s $in -L -o data.txt",%(
   :$cwd,
);

"task.bash".IO.spurt("cat data.txt");

my $me = Sparky::JobApi.new: :mine;

$me.put-file("{$*CWD}/task.check","task.check");

$me.put-file("{$*CWD}/data.txt","data.txt");


task-run ".";
